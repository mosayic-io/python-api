# App environment (development or production). Interactive API docs
# (/docs, /redoc) are disabled when this is set to production.
APP_ENV=development

# Your Supabase project URL: swap <IP ADDRESS FROM METRO> for your machine's LAN IP address — the same one you set in the mobile app's .env
SUPABASE_URL=http://<IP ADDRESS FROM METRO>:54321

# Your Supabase secret key (get this by running supabase start or supabase status)
SUPABASE_SECRET_KEY=get-this-from-running-supabase-start-or-supabase-status

# Outgoing email via Resend (https://resend.com). Keep EMAIL_ENABLED=false in
# development — emails are logged instead of sent. EMAIL_FROM must use your
# verified Resend domain, e.g. "Your App <hello@yourapp.com>"
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=

# Shared secret required in the X-Webhook-Secret header of the Supabase
# database webhook that triggers the welcome email
EMAIL_WEBHOOK_SECRET=
