# App environment (development or production). Interactive API docs
# (/docs, /redoc) are disabled when this is set to production.
APP_ENV=development

# Your Supabase project URL: Note the ip address is tailored for use over your local network (you probably don't need to change this)
SUPABASE_URL=http://192.168.1.102:54321

# Your Supabase secret key (get this by running supabase start or supabase status)
SUPABASE_SECRET_KEY=get-this-from-running-supabase-start-or-supabase-status
